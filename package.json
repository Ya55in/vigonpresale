{
  "name": "vigon-presale",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vigon/web",
    "dev:web": "npm run dev --workspace=@vigon/web",
    "dev:worker": "npm run dev --workspace=@vigon/worker",
    "dev:tout": "node scripts/dev-tout.mjs",
    "worker:service": "node scripts/worker-service.mjs",
    "build": "npm run build --workspace=@vigon/web",
    "gen:types": "node scripts/gen-types.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts",
    "lint": "npm run lint --workspaces --if-present",
    "test:services": "tsx scripts/test-services.ts",
    "essai:extraction": "tsx scripts/essai-extraction.ts",
    "init:storage": "tsx scripts/init-storage.ts",
    "essai:demande": "tsx scripts/essai-demande.ts",
    "essai:relire": "tsx scripts/essai-relire.ts",
    "verifier:permissions": "tsx scripts/verifier-permissions.ts",
    "verifier:roles": "tsx --tsconfig scripts/tsconfig.json scripts/verifier-roles.ts",
    "essai:sourcing": "tsx scripts/essai-sourcing.ts",
    "essai:consultations": "tsx scripts/essai-consultations.ts",
    "essai:planification": "tsx scripts/essai-planification.ts",
    "essai:relances": "tsx scripts/essai-relances.ts",
    "essai:relance-html": "tsx scripts/essai-relance-html.ts",
    "essai:devis": "tsx scripts/injecter-devis-essai.ts",
    "essai:expiration": "tsx scripts/essai-expiration.ts",
    "essai:smtp": "tsx scripts/essai-smtp.ts",
    "essai:reception-devis": "tsx scripts/essai-reception-devis.ts",
    "essai:cles": "tsx scripts/essai-cles.ts",
    "essai:fournisseur": "tsx scripts/essai-fournisseur.ts",
    "essai:parametrage": "tsx scripts/essai-parametrage.ts",
    "essai:gabarits": "tsx scripts/essai-gabarits-base.ts",
    "essai:comparatif": "tsx scripts/essai-comparatif-relance.ts",
    "essai:relance-client": "tsx scripts/essai-relance-client.ts",
    "essai:reponse-fournisseur": "tsx scripts/essai-reponse-fournisseur.ts",
    "essai:bout-en-bout-reel": "tsx scripts/essai-bout-en-bout-reel.ts",
    "generer:cahier-charges": "tsx scripts/generer-cahier-charges.tsx",
    "indexer:historique": "tsx scripts/indexer-historique.ts",
    "essai:rag": "tsx scripts/essai-rag-fournisseurs.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "essai:contacts": "tsx scripts/essai-contacts-fournisseur.ts",
    "essai:securite": "tsx scripts/essai-securite.ts",
    "essai:historique": "tsx --tsconfig scripts/tsconfig.json scripts/essai-historique.ts",
    "essai:documents": "tsx --tsconfig scripts/tsconfig.json scripts/essai-documents.ts",
    "essai:bout-en-bout": "tsx --tsconfig scripts/tsconfig.json scripts/essai-bout-en-bout.ts",
    "essai:whatsapp": "tsx --tsconfig scripts/tsconfig.json scripts/essai-whatsapp.ts",
    "essai:envoi-offre": "tsx --tsconfig scripts/tsconfig.json scripts/essai-envoi-offre.ts",
    "essai:ia-secours": "tsx --tsconfig scripts/tsconfig.json scripts/essai-ia-secours.ts",
    "essai:worker": "tsx --tsconfig scripts/tsconfig.json scripts/essai-worker.ts",
    "relancer:bloquees": "tsx --tsconfig scripts/tsconfig.json scripts/relancer-bloquees.ts",
    "purger:bloquees": "tsx --tsconfig scripts/tsconfig.json scripts/purger-bloquees.ts",
    "essai:repondre": "tsx --tsconfig scripts/tsconfig.json scripts/repondre-consultations.ts",
    "essai:whatsapp-reel": "tsx --tsconfig scripts/tsconfig.json scripts/essai-whatsapp-reel.ts",
    "essai:telegram": "tsx --tsconfig scripts/tsconfig.json scripts/essai-telegram.ts",
    "telegram:contacts": "tsx --tsconfig scripts/tsconfig.json scripts/telegram-contacts.ts",
    "essai:costing": "tsx --tsconfig scripts/tsconfig.json scripts/essai-costing.ts",
    "essai:parcours": "tsx --tsconfig scripts/tsconfig.json scripts/essai-parcours-complet.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "zod": "^3.24.1",
    "@types/react": "^19.2.18"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.2"
  }
}
