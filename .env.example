# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bouton « Continuer avec Google » sur l'écran de connexion.
# `true` seulement APRÈS avoir activé le fournisseur Google dans le tableau de
# bord Supabase (Authentication > Providers). Sans cette étape, le bouton
# renvoie « provider is not enabled » et paraît être une panne du service.
NEXT_PUBLIC_AUTH_GOOGLE=
TENANT_SLUG=vigon

# --- Fournisseur IA ---
# DEUX CLÉS, ET LE RESTE EST DÉDUIT.
#
# Collez n'importe quelle clé de modèle de conversation : la plateforme
# reconnaît l'émetteur à son préfixe (sk-or-v1- OpenRouter, sk-proj- OpenAI,
# sk-ant- Anthropic, gsk_ Groq), choisit un modèle disponible dans son
# catalogue, et en change tout seul si celui-ci disparaît.
#
# Changer de fournisseur = remplacer la clé. Rien d'autre.
IA_CLE_PRINCIPALE=
IA_CLE_ALTERNATIVE=

# Facultatif : impose un modèle au lieu du choix automatique.
IA_MODELE_PRINCIPAL=
IA_MODELE_ALTERNATIF=

# Facultatif : pour une API compatible OpenAI que le préfixe ne permet pas
# d'identifier (serveur local, passerelle interne).
IA_URL_PRINCIPALE=
IA_URL_ALTERNATIVE=

# --- Vectorisation (à part, et pour une bonne raison) ---
# Gemini n'est pas ici un modèle de conversation interchangeable : c'est la
# seule source des vecteurs de la recherche sémantique de fournisseurs. La
# retirer désactive cette recherche, pas la conversation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- WhatsApp (validation interne) ---
# CES DEUX VALEURS SE SAISISSENT PLUTÔT DANS /admin.
#
# Comme les clés IA, elles sont « gérées » : la valeur en base l'emporte sur
# celle d'ici, et la saisir dans l'écran évite un redéploiement. Elles ne
# figurent ici que comme repli, et pour dire qu'elles existent.
#
# Vides, la validation part par courriel et rien ne change — aucun appel réseau
# n'est tenté. C'est `whatsappConfigure()` qui en décide.
#
# PHONE_NUMBER_ID n'est PAS le numéro de téléphone : c'est son identifiant
# interne, visible dans l'onglet « API Setup » de l'app Meta. Un compte Business
# en porte plusieurs, et sans lui l'API ne sait pas qui envoie.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Gamma ---
GAMMA_API_KEY=
GAMMA_THEME_NAME=vigon-systems

# --- Firecrawl ---
FIRECRAWL_API_KEY=

# --- Boîte mail RÉCEPTION client (IMAP) ---
IMAP_CLIENT_HOST=imap.gmail.com
IMAP_CLIENT_PORT=993
IMAP_CLIENT_USER=
IMAP_CLIENT_PASSWORD=

# --- Gmail API compte PRINCIPAL (validation interne + envoi client) ---
GMAIL_PRINCIPAL_CLIENT_ID=
GMAIL_PRINCIPAL_CLIENT_SECRET=
GMAIL_PRINCIPAL_REFRESH_TOKEN=
GMAIL_PRINCIPAL_ADDRESS=

# --- Gmail API compte FOURNISSEUR (envoi RFQ + relances) ---
GMAIL_FOURNISSEUR_CLIENT_ID=
GMAIL_FOURNISSEUR_CLIENT_SECRET=
GMAIL_FOURNISSEUR_REFRESH_TOKEN=
GMAIL_FOURNISSEUR_ADDRESS=
GMAIL_LABEL_SUIVI=Label_423645884378632141

# --- Règles métier ---
MARGE_DEFAUT_PCT=25
TVA_PCT=20
DELAI_RELANCE_HEURES=48
MAX_RELANCES=3
DELAI_EXPIRATION_OFFRE_JOURS=15
SEUIL_VALIDATION_FINANCE_MONTANT=100000
SEUIL_VALIDATION_FINANCE_MARGE_MIN=15
